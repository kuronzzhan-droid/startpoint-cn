+    assert.equal(getCharacterExpCap(WAGNER, 5, 8), 679988)
+    assert.equal(getCharacterExpCap(OTHER_FIVE_STAR, 5, 8), undefined)
+    assert.equal(estimateExtendedCharacterLevel(WAGNER, 5, 379988), 100)
