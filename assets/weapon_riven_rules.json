    "damage_raw_scale": 100000,
    "integer_consumer_rounding": "resolveInt类在r(L)之后另做round_as3(r(L)/100000)；例如定额减伤kind43显示整数伤害值。",
    "decimal_interpolation": "r(L) = round_as3(Araw + (Braw - Araw) * (L - 1) / 99)；Araw/Braw先按kind单位及符号转换为整数raw。",
