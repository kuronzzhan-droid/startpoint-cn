package pinball.common.data.quest.normal.character {import pinball.common.data.player.PlayerLogic;public class CharacterQuestLogic {public var id:int;public var visibleAt:Number=0;public var calls:int=0;public function CharacterQuestLogic(id:int){this.id=id;}public function isCleared(p:PlayerLogic):Boolean{calls++;if(p.fail)throw new Error('contains-fixture-failure');return Boolean(p.cleared[id]);}public function isViewable(p:PlayerLogic,time:Number):Boolean{return time>=visibleAt;}public function isSelectable(p:PlayerLogic,time:Number):Boolean{return p.selectable;}}}