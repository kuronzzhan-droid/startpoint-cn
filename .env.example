# ═══════════════════════════════════════════════════════════════════════
# StarPoint CN 环境变量示例
# ═══════════════════════════════════════════════════════════════════════
# 复制为 .env 后再按部署环境修改：cp .env.example .env
# 带值且未注释的项目组成一套可直接启动的安全默认配置。
# 以“# 变量名=”列出的项目均为可选调优项；不确定时保持注释，使用代码默认值。
# 不要把真实密码、私有域名令牌或其他密钥提交到 Git。

# ═══════════════════════════════════════════════════════════════════════
# 基础目录、时间与玩法
# ═══════════════════════════════════════════════════════════════════════

# CDN 资源目录，相对于项目根目录；也可以填写绝对路径。
CDN_DIR=".cdn"

# 数据库目录。未设置时使用项目根目录下的 .database；迁移该路径前必须停服并备份。
# DATA_DIR=".database"

# 每日/每周复位时间，使用服务端本地时区，范围 0-23。
DAILY_RESET_HOUR=5

# 战斗掉落倍数。正式服建议保持 1；调高会直接改变游戏奖励。
DROP_MULTIPLIER=1

# 客户端召唤 COM 的等待秒数。
# SUMMON_COM_SECONDS=5

# 严格战斗结算模式。开启后禁止根据请求和持久化记录重建丢失的进行中关卡；
# 可能降低兼容性，仅用于定位异常结算，正式服通常保持 false。
# QUEST_FINISH_STRICT=false

# CN_RES_VERSION 已废弃，不要再设置。资源版本由 CDN 差分包和
# assets/asset-patch/manifest.json 中启用的补丁自动计算。

# ═══════════════════════════════════════════════════════════════════════
# HTTP 服务、管理面板与 CDN
# ═══════════════════════════════════════════════════════════════════════

# CN 服务端 HTTP 监听地址与端口。
CN_LISTEN_HOST="0.0.0.0"            # 监听所有网卡，允许局域网设备连接
CN_LISTEN_PORT="8001"               # 游戏 API、Web 管理面板和 CDN 资源

# 默认忽略 X-Forwarded-For；直连或 Windows portproxy 保持默认 false。
# 真正的 HTTP 反向代理必须覆盖客户端转发头，才可显式信任：
# 同机 nginx 用 loopback；异机/容器代理填实际源地址或 CIDR，多个用逗号分隔。
# TRUST_PROXY="false"

# 全局服（国际服 Kakao 版本，一般不使用）。
LISTEN_HOST="localhost"
LISTEN_PORT="8000"

# 客户端访问 CDN 的完整 HTTP(S) 基址。
# 本机模拟器可用 127.0.0.1；真机改为局域网 IP；云服可填写 Cloudflare 域名。
# 地址可以带路径和末尾斜杠，但不能包含账号密码、查询参数或 # 片段。
CDN_BASE_URL="http://127.0.0.1:8001/patch/cn"

# Wiki 管理员队伍码只读 API。未配置时 12 位队伍码返回不可用，旧 10 位本地码不受影响。
# COMMUNITY_TEAM_CODES_URL="https://wf-mod-wiki.pages.dev/api/community/game-codes"

# Fastify 日志级别：trace/debug/info/warn/error/fatal/silent。
# 生产 CPU 优先默认不输出逐请求 access log；本地排障可临时改为 info。
LOG_LEVEL="warn"

# 管理面板登录保护。必须自行设置；留空或未配置时拒绝所有登录。
ADMIN_PANEL_PASSWORD=""             # 使用独立长随机密码，不要提交真实密码
# ADMIN_SESSION_TTL_HOURS=12         # 登录会话有效期，范围 1-168 小时
# ADMIN_COOKIE_SECURE=false          # 管理面板全程使用 HTTPS 时设为 true

# 游戏热路径明细默认关闭；不会影响 warning/error 和聚合性能汇总。
GAME_VERBOSE_LOGS=false
# 卡池种子/抽卡明细诊断默认关闭，仅排障时开启。
# GACHA_VERBOSE_LOGS=false

# 每分钟输出一条聚合性能摘要，使用常量空间，不逐请求刷性能日志。
ROUTE_PERF_SUMMARY=true
# 每请求阶段细分会增加热路径开销；仅定位 receive/application/serialize 时开启。
# ROUTE_PERF_DETAIL=false
# ROUTE_PERF_INTERVAL_MS=60000       # 最小 10000 毫秒

# 常驻内存汇总：RSS、线程堆、连接与队列，每分钟一条。
MEMORY_DIAGNOSTICS=true
# 深度排漏统计默认关闭；排障时开启 V8 附加统计、活跃资源及容器遍历。
MEMORY_DIAGNOSTICS_DETAIL=false
# Windows 原生内存区域扫描默认关闭；true 会自动启动隐藏 PowerShell 采集。
# 此功能由服务自身调用，与外部 Memory Capture 工具是否运行无关。
PROCESS_MEMORY_DIAGNOSTICS=false
# SQL 编译/执行计数与 1/64 采样：排障时临时开启。
# false 不影响 SQL statement 缓存、事务执行、错误处理及基础性能汇总。
# MEMORY_DIAGNOSTICS=false 时，开启的 SQL 统计改用 [SQLITE-PERF] 输出。
SQLITE_DIAGNOSTICS=false
# 上述诊断配置修改后重启服务生效；游戏缓存与持久化优化无需关闭。

# ═══════════════════════════════════════════════════════════════════════
# 四核 CPU 调度
# ═══════════════════════════════════════════════════════════════════════
# 4 核及以上默认启用 SQLite 内存参数与 checkpoint worker。响应编码
# worker 在当前负载下增加总 CPU，默认关闭，仍可显式开启做吞吐对照。
# CN_MULTICORE=0                         # 关闭新增 SQLite/checkpoint 多核默认值
CN_RESPONSE_WORKERS=0                    # CPU 优先；吞吐/事件循环优先可试 1
# SQLITE_CACHE_KIB=65536                 # 每连接页缓存上限，单位 KiB
# SQLITE_MMAP_MIB=256                    # 只读映射窗口，单位 MiB
# SQLITE_SYNCHRONOUS=FULL                # NORMAL 可降 fsync CPU，但降低断电持久性

# ═══════════════════════════════════════════════════════════════════════
# /load HTTP 压缩（云服 3 Mbps 上行推荐）
# ═══════════════════════════════════════════════════════════════════════
# 仅压缩客户端声明支持的 /load 响应，不修改玩家存档内容。
# 可选模式：off / observe / gzip / br / auto。
# gzip level 1 的 CPU 开销较低；出现问题时改为 off 并重启即可即时撤回。
# CPU 优先且带宽充足时保持 off；3 Mbps 等受限链路再改为 gzip。
CN_LOAD_HTTP_COMPRESSION="off"
CN_LOAD_HTTP_GZIP_LEVEL=1
CN_LOAD_HTTP_COMPRESSION_LOG=false   # 仅短期排障时设为 true，避免持续刷登录日志

# 小于该字节数的 /load 响应不压缩。
# CN_LOAD_HTTP_COMPRESSION_MIN_BYTES=4096
# 仅 br/auto 模式使用；数值越高越耗 CPU，云服不建议随意调高。
# CN_LOAD_HTTP_BROTLI_QUALITY=3

# ═══════════════════════════════════════════════════════════════════════
# 数据库领取历史维护
# ═══════════════════════════════════════════════════════════════════════
# 每名玩家只保留最新 500 条领取记录。任务按玩家低峰分批执行，不补跑错过的日期。
RECEIVE_HISTORY_RETENTION_ENABLED=true
# 使用云服务器本地时间；默认每天 04:30。
RECEIVE_HISTORY_RETENTION_TIME="04:30"
# 每个 SQLite 删除事务最多处理的行数；较小值更容易让出 TCP/HTTP 事件循环。
# RECEIVE_HISTORY_RETENTION_DELETE_BATCH_ROWS=250

# 4 核多核模式默认开启；设为 0 可单独关闭。在线仅执行 PASSIVE 回写。
# 已回写的 WAL 空间可复用，物理文件不一定立即变小；强制截断仅在停写维护时执行。
# SQLITE_CHECKPOINT_WORKER=0
# SQLITE_CHECKPOINT_INTERVAL_MS=5000
# SQLITE_CHECKPOINT_BUSY_TIMEOUT_MS=0

# 可选的业务持久化 worker；默认关闭，完成本地双模拟器验证后再考虑开启。
# 开启后，已命令化的低优先级写入会使用独立 SQLite 连接执行；未命令化的事务仍留在主进程。
# SQLITE_PERSISTENCE_WORKER=1
# SQLITE_PERSISTENCE_BUSY_TIMEOUT_MS=1000
# SQLITE_PERSISTENCE_MAX_ATTEMPTS=3

# 单写线程：把已注册的业务写入放到独立线程，主线程只保留 HTTP、联机和读取。
# 默认关闭；关闭时同一套命令在主进程内执行，业务结果不变。
# CN_WRITER_THREAD=1
# 组提交窗口：同一窗口内到达的命令合并成一次 COMMIT，减少 fsync 次数。0 关闭。
# SQLITE_GROUP_COMMIT_WINDOW_MS=2
# 单批命令上限。
# SQLITE_GROUP_COMMIT_MAX=64
# 写线程侧 SQLite busy 超时、命令排队上限与同时在途上限。
# SQLITE_WRITER_BUSY_TIMEOUT_MS=1000
# SQLITE_WRITER_QUEUE_MAX=512
# SQLITE_WRITER_MAX_IN_FLIGHT=32
# 单条命令超时；超时后拒绝该命令并重启写线程（关闭连接会让未提交事务回滚）。0 关闭。
# SQLITE_WRITER_COMMAND_TIMEOUT_MS=30000
# 写线程异常退出后的自动重启次数上限。
# SQLITE_WRITER_MAX_RESTARTS=5
# 仅在写线程不可用且明确要求时回退到进程内执行；默认关闭，避免静默回到旧行为。
# SQLITE_WRITER_FALLBACK=0

# ═══════════════════════════════════════════════════════════════════════
# 公网部署（云服务器）
# ═══════════════════════════════════════════════════════════════════════
# 详细步骤见 docs/deployment.md。部署时按实际情况覆盖上面的同名配置，
# 不要在同一个 .env 中保留两个生效的同名变量。

# CN_LISTEN_HOST="127.0.0.1"                         # 仅由 nginx 反向代理访问时使用
# CDN_BASE_URL="https://<YOUR_CLOUDFLARE_DOMAIN>/patch/cn"
# SESSION_PUBLIC_HOST="<YOUR_DOMAIN>"                # 联机 TCP 客户端看到的公网地址
# CN_PUBLIC_HOST="<YOUR_DOMAIN>"                     # SESSION_PUBLIC_HOST 未设置时的回退

# ═══════════════════════════════════════════════════════════════════════
# 联机 TCP 会话服务器
# ═══════════════════════════════════════════════════════════════════════

SESSION_PORT="8003"
SESSION_HOST="0.0.0.0"              # 需要接收外部 TCP；防火墙只开放实际所需端口

# TCP 握手、帧大小和 KeepAlive 防护。合法客户端通常无需调整。
# SESSION_HANDSHAKE_TIMEOUT_MS=15000
# SESSION_TCP_KEEPALIVE_MS=10000
# SESSION_MAX_FRAME_BYTES=262144
# SESSION_MAX_BUFFER_BYTES=1048576    # 不得小于 SESSION_MAX_FRAME_BYTES
# 每次事件循环最多处理的完整 TCP 帧数；剩余帧会让出事件循环后继续处理。
# SESSION_MAX_FRAMES_PER_TICK=128
# 战斗逐帧转发隔离，默认关闭；混合 native/proxy 房间仍由主进程统一转发。
# MULTI_BATTLE_RELAY_PROCESS=0
# MULTI_BATTLE_RELAY_ACTIVITY_MS=250
# MULTI_BATTLE_RELAY_MAX_RESTARTS=5

# HTTP 选房到 TCP 握手之间的席位预留时间；默认 60 秒，包含加成弹窗与加载。
# MULTI_ROOM_ADMISSION_TTL_MS=60000

# 房间生命周期清理。
# MULTI_ROOM_INCOMPLETE_EXPIRY_MS=600000   # 未满 3 人房间：10 分钟
# MULTI_ROOM_FULL_EXPIRY_MS=1800000        # 满 3 人未开战房间：30 分钟
# MULTI_ROOM_CLEAN_INTERVAL_MS=60000       # 清理检查间隔：60 秒
# BATTLE_ROOM_TIMEOUT_MS=900000            # 所有真人断开后的战斗保留：15 分钟

# 战斗连接租约。loading 使用固定上限；SceneReady 后按活动续租。
# 到期后服务端会先让一次 socket I/O 轮次再复核，避免 CPU 忙时误杀已到达的心跳。
# BATTLE_LOADING_LEASE_MS=60000
# BATTLE_HEARTBEAT_LEASE_MS=25000
# 换场（LevelNext）后，连接仍在但始终没开始加载下一场景的成员最多等待多久；
# 到期断开该成员并按原有缺席宽限转 AI，其余成员继续。五重已进入战斗的连接
# 没有心跳租约，没有这个上限时队友会在换场画面无限等待。
# BATTLE_LEVEL_NEXT_DEADLINE_MS=90000

# 断线、替换连接与结算返回宽限时间。
# REMATCH_RECONNECT_GRACE_MS=60000          # 续战返回大厅后的真人回连宽限：60 秒
# MULTI_HOST_RECONNECT_GRACE_MS=25000
# SETTLEMENT_RETURN_GRACE_MS=60000
# MULTI_SUPERSEDED_SOCKET_CLOSE_MS=60000
# MULTI_MAX_SUPERSEDED_CONNECTIONS_PER_VIEWER=2   # 范围 1-32
# MULTI_DISBAND_SOCKET_GRACE_MS=20000             # 默认发送队列上限时间 + 5 秒

# 救援房间等待与重连。
# RESCUE_GUEST_WAIT_MS=180000
# RESCUE_GUEST_READY_WAIT_MS=600000
# RESCUE_GUEST_WARNING_MS=30000
# RESCUE_GUEST_RECONNECT_GRACE_MS=25000

# 随机招募通知重投递。
# MULTI_RECRUITMENT_LIFETIME_MS=30000
# MULTI_RECRUITMENT_REDELIVERY_LIMIT=20

# 多人结算屏障、快照与重复请求保护。
# MULTI_SETTLEMENT_BARRIER_MS=1200
# MULTI_BATTLE_SNAPSHOT_TTL_MS=900000
# MULTI_SETTLEMENT_SNAPSHOT_TTL_MS=120000
# FINISH_RESPONSE_CACHE_TTL_MS=120000
# FINISH_RESPONSE_CACHE_MAX=512

# 多人 TCP 发送背压保护。单个慢连接超限时只断开该连接。
# MULTI_SEND_QUEUE_MAX_MESSAGES=512
# MULTI_SEND_QUEUE_MAX_BYTES=4194304
# MULTI_SEND_QUEUE_MAX_AGE_MS=15000
# 断线原因在 [MEM].counters.tcpDisconnects 中按固定枚举累计，不记录玩家/IP/包内容。

# 随机招募后等待真人的最长时间；超时后补齐 AI 队友（电脑队友）。单位毫秒，默认 120000（120 秒）。
# 仅作用于首次招募的大厅；续战补 AI 使用上面的 REMATCH_RECONNECT_GRACE_MS。
# MULTI_AI_FILL_TIMEOUT_MS=120000

# NPC 加入节奏和玩家队伍池缓存。
# NPC_JOIN_DELAY_MS=2000
# NPC_READY_DELAY_MS=500
# NPC_PARTY_POOL_TTL_MS=300000
# NPC_PARTY_POOL_MAX_ENTRIES=5000
# NPC_PARTY_POOL_MIN_BATTLE_POWER=8000

# ═══════════════════════════════════════════════════════════════════════
# 联机诊断（默认全部关闭）
# ═══════════════════════════════════════════════════════════════════════
# 仅在采集多人 Chain 或发送阻塞样本时短期开启。
# 日志写入 .logs/multi-chain-*.jsonl，并受大小限制；正常包不会逐包记录。
# MULTI_CHAIN_DIAGNOSTIC=false
# MULTI_CHAIN_DIAGNOSTIC_MAX_BYTES=33554432
# MULTI_CHAIN_DIAGNOSTIC_MAX_PAYLOAD_CHARS=16384
# MULTI_CHAIN_SEND_DIAGNOSTIC=false
# MULTI_CHAIN_SEND_DIAGNOSTIC_MIN_BLOCK_MS=100

# 每场多人战斗结束时输出一行 [MULTI-BATTLE] 摘要（默认开启，开销为计数器）：
# 时长、屏障等待、每名成员的包数/最长静默/线路警告/背压/断线原因、主线程卡顿。
# 最近的摘要也可从管理接口 GET /api/server/diagnostics/battles 读取。
# MULTI_BATTLE_TELEMETRY=true
# MULTI_BATTLE_TELEMETRY_RECENT=100

# ═══════════════════════════════════════════════════════════════════════
# iOS 1.8.4 兼容（默认关闭）
# ═══════════════════════════════════════════════════════════════════════
# 只影响 iOS 发布信息，Android 响应保持不变。
# IOS_API_HOST 只填 host[:port]，不能带协议或路径；IPA 补丁目标约有 26 字节限制。
IOS_COMPAT_ENABLED="0"
# IOS_API_HOST="<YOUR_API_HOST>"
# IOS_API_SCHEME="https"

# ═══════════════════════════════════════════════════════════════════════
# 可选 Mode15 模块（高级配置）
# ═══════════════════════════════════════════════════════════════════════
# 未安装可选模块时基础服仍可运行。设为 0 可明确禁止加载。
# MODE15_ENABLED=0
# MODE15_MODULE_PATH="./mode15"
# MODE15_ALLOW_CHARACTER_REUSE=false
